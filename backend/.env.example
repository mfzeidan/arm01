# Anthropic API key for Claude Vision
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Jetson Orin Nano IP (for remote deployment)
JETSON_HOST=192.168.x.x
JETSON_USER=mark

# Camera indices (from lerobot-find-cameras)
CAMERA_TOP_INDEX=0
CAMERA_FRONT_INDEX=1

# LeRobot arm ports (from lerobot-find-port)
FOLLOWER_PORT=/dev/tty.usbmodemXXXXX
LEADER_PORT=/dev/tty.usbmodemXXXXX
